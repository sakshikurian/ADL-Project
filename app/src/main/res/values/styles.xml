<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base styles to prevent implicit AAPT parent resolution errors -->
    <style name="Text" />
    <style name="Card" parent="Widget.MaterialComponents.CardView" />

    <style name="Text.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Text.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Text.Body.Muted">
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Text.Micro">
        <item name="android:textSize">@dimen/text_micro</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Card.Base">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/soft_sage</item>
    </style>

    <style name="Card.Hero">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_hero</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Card.Small">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/radius_card_small</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_green</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <style name="Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_green</item>
        <item name="android:textColor">@color/primary_green</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

</resources>
