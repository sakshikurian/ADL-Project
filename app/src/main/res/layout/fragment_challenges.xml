<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:clipToPadding="false"
    tools:context=".ui.fragments.ChallengesFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            style="@style/Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/challenges_title" />

        <TextView
            style="@style/Text.Body.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/challenges_subtitle" />

        <!-- Featured Challenge -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="@dimen/elevation_card"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_challenge_gradient">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/Text.Micro"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="#D6E8D9"
                            android:text="TODAY\'S FEATURED" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_points_chip"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/white"
                            android:text="+20 Eco Points" />
                    </LinearLayout>

                    <TextView
                        style="@style/Text.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white"
                        android:text="@string/challenge_title" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#D6E8D9"
                        android:text="@string/challenge_description" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#A2D3A8"
                        android:text="👥 1,240 eco members participating" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJoinChallengeTab"
                        style="@style/Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/challenge_join"
                        android:textColor="@color/forest_green"
                        app:backgroundTint="@color/white"
                        app:icon="@drawable/ic_check"
                        app:iconTint="@color/forest_green" />

                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Community Challenges -->
        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Upcoming Community Challenges" />

        <!-- Challenge 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChallengeZeroWaste"
            style="@style/Card.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Text.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Zero Waste Weekend 📦" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_green"
                        android:fontFamily="sans-serif-medium"
                        android:text="+50 Points" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Body.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Avoid single-use packaging for 48 hours to earn +50 points." />

                <TextView
                    android:id="@+id/tvStatusZeroWaste"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textColor="@color/primary_green"
                    android:fontFamily="sans-serif-medium"
                    android:text="Tap to Join • Starts Saturday" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Challenge 3 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChallengeMeatless"
            style="@style/Card.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Text.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Meatless Monday 🥗" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_green"
                        android:fontFamily="sans-serif-medium"
                        android:text="+30 Points" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Body.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Eat plant-based meals for an entire day to reduce greenhouse emissions." />

                <TextView
                    android:id="@+id/tvStatusMeatless"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textColor="@color/primary_green"
                    android:fontFamily="sans-serif-medium"
                    android:text="Tap to Join • Starts Monday" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Challenge 4: Walking Navigation -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChallengeWalking"
            style="@style/Card.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Text.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Campus Walking Challenge 🚶" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_green"
                        android:fontFamily="sans-serif-medium"
                        android:text="+25 Points" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Body.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Navigate campus sustainability spots on foot using OpenStreetMap GPS routing." />

                <TextView
                    android:id="@+id/tvStatusWalking"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textColor="@color/primary_green"
                    android:fontFamily="sans-serif-medium"
                    android:text="Tap to Open Walking Map 🗺️" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
