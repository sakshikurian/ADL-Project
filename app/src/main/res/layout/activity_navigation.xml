<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- OpenStreetMap Container -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top App Bar, Search Inputs, Walking Distance & Log Walk Button Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Top Row: Back button + Title + Search Action -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Back"
                        android:src="@drawable/ic_nav_home"
                        app:tint="@color/forest_green" />

                    <TextView
                        style="@style/Text.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/nav_map_title"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/btnSearch"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_notification_button"
                        android:contentDescription="Calculate Route"
                        android:src="@drawable/ic_search"
                        app:tint="@color/primary_green" />
                </LinearLayout>

                <!-- Source Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_navigation"
                        app:tint="@color/primary_green"
                        android:contentDescription="Source" />

                    <EditText
                        android:id="@+id/etSearchSource"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_notification_button"
                        android:hint="Start: My Location (or type place)"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnUseMyLocation"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Use My Location"
                        android:src="@drawable/ic_navigation"
                        app:tint="@color/forest_green" />
                </LinearLayout>

                <!-- Destination Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_leaf"
                        app:tint="@color/forest_green"
                        android:contentDescription="Destination" />

                    <EditText
                        android:id="@+id/etSearchDestination"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_notification_button"
                        android:hint="Destination: Place or campus building..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Route Distance & Status Section (Replaces Old Chips) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDistanceEta"
                            style="@style/Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enter destination and tap search"
                            android:textColor="@color/primary_green"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvCo2SavingsBanner"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:text="🌿 Earn 5 eco-points per km walked" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressRouting"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Compact Turn Guidance -->
                <TextView
                    android:id="@+id/tvTurnByTurn"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_notification_button"
                    android:maxLines="2"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="5dp"
                    android:text="Ready: GPS coordinates active. Walking routes save CO₂."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <!-- Prominent Log Walk (+X points) Button Below Distance -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogWalk"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="Log Walk (+0 points)"
                    android:enabled="false"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Floating Action Button for My Location -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/nav_recenter"
        android:src="@drawable/ic_navigation"
        app:backgroundTint="@color/surface_card"
        app:fabSize="mini"
        app:tint="@color/primary_green" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
