<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:id="@+id/ivStatIcon"
        android:layout_width="@dimen/icon_chip_size"
        android:layout_height="@dimen/icon_chip_size"
        android:padding="9dp"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvStatValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        style="@style/Text.Title"
        app:layout_constraintTop_toBottomOf="@id/ivStatIcon"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="24" />

    <TextView
        android:id="@+id/tvStatLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        style="@style/Text.Caption"
        app:layout_constraintTop_toBottomOf="@id/tvStatValue"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Activities" />

</merge>
