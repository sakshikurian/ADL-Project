<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toggleContainer"
    android:layout_width="68dp"
    android:layout_height="34dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Track background (color changes dynamically) -->
    <View
        android:id="@+id/viewTrack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_toggle_track_on" />

    <!-- Label inside the toggle: ON or OFF -->
    <TextView
        android:id="@+id/tvToggleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="10dp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.05"
        android:text="@string/switch_text_on"
        android:textColor="@color/white"
        android:textSize="11sp" />

    <!-- Sliding circular thumb -->
    <View
        android:id="@+id/viewThumb"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_toggle_thumb"
        android:elevation="2dp" />

</FrameLayout>
